<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application android:label="Fixfl autostart" android:icon="@android:drawable/ic_menu_compass">
        <activity android:name="nl.fixfl.autostart.MainActivity"
                  android:theme="@android:style/Theme.Black.NoTitleBar"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name="nl.fixfl.autostart.StartService" />

        <receiver android:name="nl.fixfl.autostart.StartReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.android.server.SyncAndroidService.RESUME" />
                <category android:name="com.android.server.SyncAndroidService.RESUME" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
